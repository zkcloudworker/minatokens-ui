{
  "name": "minatokens-ui",
  "version": "0.2.0",
  "description": "MinaTokens UI",
  "author": "DFST/MAZ",
  "scripts": {
    "dev": "next dev",
    "build": "dotenv -e .env.local -- prisma generate --no-hints && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "dotenv -e .env.local -- prisma generate --no-hints",
    "prisma:format": "prisma format",
    "prisma:seed": "dotenv -e .env.local -- prisma db seed",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev --name v28",
    "prisma:status": "dotenv -e .env.local -- prisma migrate status",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "postinstall": "dotenv -e .env.local -- prisma generate --no-hints",
    "test": "jest",
    "jwt": "dotenv -e .env.local -- tsx --test test/jwt.test.ts",
    "prisma:test": "dotenv -e .env.local -- tsx --test test/prisma.test.ts",
    "mesa:test": "dotenv -e .env.local -- tsx --test test/mesa.test.ts",
    "test:watch": "jest --watch",
    "update": "ncu -i -u"
  },
